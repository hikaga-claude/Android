<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- 上10% の余白 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- コンテンツ 80% -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:orientation="vertical"
        android:padding="6dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="西川さんお寿司カウンター"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:maxLines="1"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="false">

        <!-- まぐろ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="まぐろ"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_0"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_0"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_0"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

        <!-- いか -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="いか"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_1"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_1"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_1"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

        <!-- えび -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="えび"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_2"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_2"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_2"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

        <!-- ぶり -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ぶり"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_3"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_3"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_3"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

        <!-- たまご -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="たまご"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_4"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_4"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_4"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

        <!-- かずき -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:layout_margin="3dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_name_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="かずき"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:padding="4dp"
                    android:background="#E3F2FD" />
                <TextView
                    android:id="@+id/tv_count_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="vertical">
                <Button android:id="@+id/btn_inc_5"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_plus" android:textColor="#1976D2" />
                <Button android:id="@+id/btn_dec_5"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_minus" android:textColor="#546E7A" />
                <Button android:id="@+id/btn_rst_5"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="18sp" android:padding="0dp"
                    android:background="@drawable/btn_reset" android:textColor="#B0BEC5" />
            </LinearLayout>
        </LinearLayout>

    </GridLayout>

    </LinearLayout>
    <!-- コンテンツここまで -->

    <!-- 下10% の余白 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
