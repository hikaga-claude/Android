<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="西川さんお寿司カウンター"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:maxLines="1"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="false">

        <!-- まぐろ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="まぐろ"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_0"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_0"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_0"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- いか -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="いか"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_1"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_1"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_1"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- えび -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="えび"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_2"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_2"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_2"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ぶり -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ぶり"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_3"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_3"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_3"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- たまご -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="たまご"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_4"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_4"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_4"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- かずき -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#FFFFFF"
            android:layout_margin="4dp"
            android:padding="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="かずき"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />
            <TextView
                android:id="@+id/tv_count_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btn_inc_5"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="＋"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_dec_5"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="－"
                    android:textSize="16sp" android:padding="0dp" />
                <Button android:id="@+id/btn_rst_5"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="×"
                    android:textSize="16sp" android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>

    </GridLayout>

</LinearLayout>
